<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to Jarvis on your computer, over your home WiFi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice in. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Biometric approval of self-edits. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Calling and texting. These are the permissions worth pausing over:
        CALL_PHONE dials without a further prompt, and SEND_SMS sends without
        one. They are why every outbound action in core/phone.py is confirmed
        aloud before it runs, no matter how confident the model is.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Resolving "open spotify" to a package name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        allowBackup is off deliberately. Android's backup would copy the
        encrypted settings blob to Google's servers, and the hardware key it is
        tied to cannot leave this phone — so the restore would be undecryptable
        anyway. Better to re-pair on a new device than to ship a useless copy
        of your auth token off the phone.

        networkSecurityConfig permits cleartext to your LAN and refuses it
        everywhere else. Plain HTTP over your own router is a reasonable trade;
        a self-signed cert would teach you to tap through certificate warnings,
        which is worse.
    -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The hands. Must be enabled by hand in
            Settings > Accessibility > Jarvis. Android will show a warning
            about what this service can see and do. That warning is accurate.
        -->
        <service
            android:name=".JarvisAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
